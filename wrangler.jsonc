{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vic-portfolio",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "5093e255b312417ca38d3ba5d0bc0aaf"
    },
    {
      "binding": "UPLOADS",
      "id": "0fc43d7062e44141a27a41fdd4efa224"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vic-portfolio-db",
      "database_id": "80f27db2-d1ed-4d40-bd77-bf5e5f423336"
    }
  ]
}
